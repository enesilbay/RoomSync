# Telefonun ulasabilecegi backend adresi: bilgisayarin yerel ag IP'si (ipconfig / ifconfig).
EXPO_PUBLIC_BACKEND_URL=http://192.168.x.x:3000

# SDK 56+ global fetch'i expo/fetch yapar; expo/fetch FormData'daki { uri } dosya parçalarını
# desteklemez (profil fotoğrafı ve sohbet dosya yüklemesi). React Native fetch'inde kalmak için:
EXPO_PUBLIC_USE_RN_FETCH=1
