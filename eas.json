{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://studylounge-backend.onrender.com",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://studylounge-backend.onrender.com",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    }
  }
}
